# Rust
/target
**/target
Cargo.lock.bak

# genaryx runtime data (never commit local console state or events)
/.taipan
*.sqlite
*.sqlite-wal
*.sqlite-shm
/scratch

# macOS
.DS_Store

# Xcode / SwiftPM
apps/macos/.build
apps/macos/*.xcodeproj/xcuserdata
apps/macos/*.xcodeproj/project.xcworkspace/xcuserdata
DerivedData/
*.xcframework

# Node / Tauri (desktop shell)
node_modules/
apps/desktop/dist
apps/desktop/src-tauri/target

# Secrets / keys (defense-in-depth; nothing signed lives in the tree)
*.pem
*.p8
*.key
!**/testdata/**/*.pem
.claude/

# Built frontends. `npm run build:web` regenerates dist-web on demand, and the
# filenames are content-hashed, so a committed copy is stale the next build and
# conflicts on every one after that.
apps/desktop/dist-web/
apps/desktop/dist/
node_modules/
