# Rust
/target
**/target
Cargo.lock.bak

# genaryx runtime data (never commit local console state or events)
/.taipan
*.sqlite
*.sqlite-wal
*.sqlite-shm
/scratch

# macOS
.DS_Store

# Node (web console frontend)
node_modules/

# Secrets / keys (defense-in-depth; nothing signed lives in the tree)
*.pem
*.p8
*.key
!**/testdata/**/*.pem
.claude/

# Built frontend. `pnpm build` regenerates apps/web/dist on demand, and the
# filenames are content-hashed, so a committed copy is stale the next build and
# conflicts on every one after that.
apps/web/dist/
apps/web/dist-web/
