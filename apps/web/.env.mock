# Preview build: no backend, no login gate. The transport seam
# (src/lib/transport.ts) routes every command to src/lib/mockPreview.ts and the
# bus to its synthetic stream. Deliberately does NOT set VITE_GENARYX_API, so
# isWebShell() stays false and WebGate never asks for a password.
VITE_GENARYX_MOCK=1
