[Unit]
Description=Pocket cert broker (ACME DNS-01 mediator, design A)
After=network.target

[Service]
EnvironmentFile=/root/broker/broker.env
ExecStart=/usr/bin/python3 /root/broker/broker.py
Restart=on-failure
RestartSec=2
# The broker holds the DNS credential; keep its surface small. (No ProtectHome:
# the broker legitimately lives in /root/broker, which ProtectHome would hide.)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/root/broker

[Install]
WantedBy=multi-user.target
