# Pocket cert broker environment. Copy to /root/broker/broker.env (chmod 600 if
# it holds a Cloudflare token) and edit. Loaded by the systemd unit.

# Which DNS backend publishes the ACME challenge TXT:
#   challtestsrv -> the local pebble-challtestsrv mock (proof/test only)
#   cloudflare   -> the real pocket.it-rat.com zone (production, Step 4)
BROKER_BACKEND=challtestsrv

# The zone every relay's hostname lives under.
BROKER_ZONE=pocket.it-rat.com

# Where the broker listens. Keep it loopback and reach it over the same private
# path the relay uses; do NOT expose it to the internet.
BROKER_BIND=127.0.0.1
BROKER_PORT=9000

# relay-id -> token map (JSON): each relay gets its own token at provisioning.
# Absent -> a single dev relay {"proof01":"proof-relay-token"} so the proof runs.
BROKER_RELAYS_FILE=/root/broker/relays.json

# --- challtestsrv backend ---
CHALLTESTSRV_URL=http://127.0.0.1:8055

# --- cloudflare backend (Step 4) ---
# A SCOPED token: Zone.DNS:Edit on the delegated pocket.it-rat.com zone ONLY.
# It lives only here and is never logged. Fill these to go live.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
